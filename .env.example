# OAAS does not auto-load this file. Copy the values into your web-server
# environment, or configure equivalent environment variables securely.
APP_BASE_URL=http://localhost:8000
APP_TIMEZONE=Asia/Yangon

# MySQL connection used by config/database.php.
DB_HOST=127.0.0.1
DB_NAME=smart_attendance
DB_USER=your-database-user
DB_PASS=change-me
DB_CHARSET=utf8mb4
DB_TIMEZONE=+06:30

# Optional employee self-attendance office-network restriction. It is disabled
# by default. When enabled, REMOTE_ADDR must exactly match one listed IPv4 or
# IPv6 address. Forwarded proxy headers are intentionally ignored.
ATTENDANCE_OFFICE_NETWORK_ENABLED=0
ATTENDANCE_OFFICE_ALLOWED_IPS=127.0.0.1,::1

# Verification-mail settings. For file-based local setup, copy
# config/mail.local.example.php to config/mail.local.php instead.
MAIL_TRANSPORT=log
MAIL_HOST=smtp.example.test
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=change-me
MAIL_ENCRYPTION=tls
MAIL_FROM_EMAIL=no-reply@oaas.local
MAIL_FROM_NAME=OAAS
MAIL_VERIFICATION_SUBJECT=Verify your OAAS account email
MAIL_LOCAL_HOST=localhost

# Optional OAAS-prefixed tooling settings. Existing SAPAS_* names remain
# supported as legacy fallback aliases for compatibility.
OAAS_CHROME_PATH=
OAAS_ALLOW_DEMO_SEED=0
OAAS_DEMO_EMAIL_DOMAIN=silveroakhr.com
OAAS_TEST_DB_NAME=oaas_test
OAAS_BROWSER_DB_NAME=oaas_browser_test
